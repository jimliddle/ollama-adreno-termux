# Applied only when starting the Ollama server.
export OLLAMA_VULKAN="${OLLAMA_VULKAN:-1}"
export OLLAMA_IGPU_ENABLE="${OLLAMA_IGPU_ENABLE:-1}"

# Prefer the installed Termux runtime over copies bundled with other tools.
export LD_LIBRARY_PATH="$OLLAMA_TERMUX_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# The GPU shares Android's RAM. These defaults do not override model parameters.
export OLLAMA_MAX_LOADED_MODELS="${OLLAMA_MAX_LOADED_MODELS:-1}"
export OLLAMA_NUM_PARALLEL="${OLLAMA_NUM_PARALLEL:-1}"
export OLLAMA_CONTEXT_LENGTH="${OLLAMA_CONTEXT_LENGTH:-4096}"
